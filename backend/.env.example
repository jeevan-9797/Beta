# AWS Configuration
AWS_REGION=ap-south-1
DYNAMODB_TABLE=BETA_Household
BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0

# Database Mode (Set to true to run offline mock store without AWS credentials)
LOCAL_MOCK_DB=true
MOCK_DB_FILE=backend/.mock_db.json

# Household and Security Rules Defaults
DEFAULT_HOUSEHOLD_ID=kamala
APPROVAL_TTL_SECONDS=7200
COOLING_OFF_SECONDS=20

# Twilio WhatsApp Integration (for Guardian alerts and approval flow)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
GUARDIAN_WHATSAPP_TO=whatsapp:+919876543210

# Google Calendar Integration (for medical appointments & reminders)
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_JSON={}
