# ==============================================================================
# BETA Environment Configuration Template (.env.example)
# Track 1: Make MCP Matter — Testing & Integration Suite
# ==============================================================================

# --- AWS Configuration ---
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
# AWS credentials will be sourced from standard IAM roles, SSO, or ~/.aws/credentials
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- DynamoDB Storage ---
# Single-table design (PK: HH#<household_id>, SK: MEMBER# / BILLER# / PAYEE# / etc.)
DYNAMODB_TABLE_NAME=beta-core-table-dev
TEST_HOUSEHOLD_ID=HH#kamala

# --- AWS AgentCore Gateway / MCP Endpoint ---
# Target spec: AWS AgentCore Gateway (2026-07-28 spec) single MCP endpoint
MCP_GATEWAY_URL=https://agentcore.ap-south-1.amazonaws.com/mcp/v1/beta-gateway
MCP_AUTH_TOKEN=test-token-bearer-beta-2026
# Fallback Plan B Thin Proxy Lambda URL (if AgentCore Gateway is bypassed)
PLAN_B_PROXY_URL=https://api.beta-voice.internal/mcp/proxy

# --- Cedar Policy Engine ---
CEDAR_POLICY_STORE_ID=beta-cedar-policy-store-dev
CEDAR_LOG_LEVEL=DEBUG

# --- ElevenLabs Voice Assistant Integration ---
ELEVENLABS_API_KEY=el_live_example_key_xyz
ELEVENLABS_AGENT_ID=agent_kamala_dev_v1
ELEVENLABS_VOICE_ID=voice_kannada_english_elder_v1

# --- Guardian Gate & WhatsApp Webhook (Twilio / Meta Cloud API) ---
GUARDIAN_PHONE_NUMBER=+919876543210
ELDER_PHONE_NUMBER=+919876501234
WHATSAPP_API_KEY=wa_live_example_key_abc
WHATSAPP_WEBHOOK_SECRET=wa_webhook_secret_xyz

# --- Timing & Safety Parameters (Stage Demo vs. Production) ---
# Demo mode uses 20 seconds cooling-off; production uses 1800 seconds (30 mins)
COOLING_OFF_SECONDS=20
ASSESSMENT_TTL_SECONDS=300
R2_PAYMENT_CEILING_INR=2000

# --- Test Runner Flags ---
TEST_LOG_LEVEL=INFO
MOCK_EXTERNAL_PAYMENTS=true
RUN_LIVE_GATEWAY_TESTS=false
